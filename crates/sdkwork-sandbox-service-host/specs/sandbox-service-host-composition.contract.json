    {
      "name": "sandbox_runtime_directory_capabilities",
      "type": "SandboxRuntimeDirectoryCapabilities",
      "owner": "future-approved-sandbox-runtime-bootstrap",
      "boundaryContract": "./sandbox-service-host-bootstrap.contract.json",
      "preopened": true,
      "required": true
    },
    {
      "name": "sandbox_secret_key_source",
      "port": "SandboxSecretKeySource",
      "owner": "future-approved-secret-kms-adapter",
