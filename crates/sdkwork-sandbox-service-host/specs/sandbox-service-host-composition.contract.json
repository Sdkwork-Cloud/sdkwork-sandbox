    {
      "name": "sandbox_telemetry",
      "port": "SandboxTelemetryPort",
      "owner": "future-approved-telemetry-adapter",
      "boundaryContract": "./sandbox-service-host-bootstrap.contract.json",
      "required": true
    },
    {
      "name": "sandbox_clock",
      "port": "SandboxClock",
      "owner": "composition",
      "required": true
    },
    {
      "name": "sandbox_id_generator",
      "port": "SandboxIdGenerator",
      "owner": "composition",
      "required": true
    }
  ],
  "serviceConstruction": {
    "sandbox_composition_owner": "sdkwork-sandbox-service-host",
    "sandbox_service_implementation_owner": "sdkwork-intelligence-sandbox-service",
    "sandbox_constructed_port": "SandboxSessionLifecyclePort",
    "sandbox_constructs_lifecycle_service_from_injected_dependencies": true,
    "sandbox_lifecycle_service_is_injected_input": false,
    "sandbox_single_composition_root_required": true,
    "sandbox_constructed_service_contains_deployment_profile_branches": false
  },
  "readiness": {
    "type": "SandboxServiceHostReadiness",
    "aggregation": "all-required-dimensions-ready",
    "failureMode": "fail-closed",
    "dimensions": [
      "sandbox_config",
      "sandbox_runtime_directory_capabilities",
      "sandbox_store",
      "sandbox_provider_registry",
      "sandbox_workspace_attachment",
      "sandbox_secret_key_source",
      "sandbox_telemetry",
      "sandbox_fencing"
    ],
    "dimensionStates": ["ready", "not-ready", "degraded", "unknown"],
    "safeFields": [
      "sandbox_dependency",
      "sandbox_outcome",
      "sandbox_reason_code",
      "sandbox_duration_ms",
      "sandbox_trace_id",
      "sandbox_checked_at"
    ],
    "forbiddenFields": [
      "sandbox_secret_material",
      "sandbox_database_url",
      "sandbox_physical_host_path",
      "sandbox_api_socket",
      "sandbox_provider_allocation_reference",
      "sandbox_raw_command",
      "sandbox_environment_value",
      "sandbox_tenant_name",
      "sandbox_raw_identity"
    ],
    "bounds": {
      "sandbox_check_timeout_ms": 60000,
      "sandbox_reason_code_max_length": 128,
      "sandbox_dimension_count": 8
    }
  },
  "shutdown": {
    "type": "SandboxServiceHostShutdown",
    "bounded": true,
    "idempotent": true,
    "stopNewLifecycleSideEffectsFirst": true,
    "releaseOrder": [
      "sandbox_provider_leases",
      "sandbox_provider_resources",
      "sandbox_telemetry",
      "sandbox_store"
    ],
    "timeoutOutcome": "sandbox_internal_failure",
    "operatorObservationRequired": true
  },
  "failClosedConditions": [
    "sandbox_config_invalid",
    "sandbox_runtime_directory_capabilities_unavailable",
    "sandbox_store_unavailable",
    "sandbox_provider_registry_unavailable",
    "sandbox_provider_identity_mismatch",
    "sandbox_provider_capability_mismatch",
    "sandbox_provider_assurance_insufficient",
    "sandbox_workspace_attachment_unavailable",
    "sandbox_secret_key_source_unavailable",
    "sandbox_telemetry_unavailable",
    "sandbox_fencing_unprovable",
    "sandbox_gate_dependency_missing",
    "sandbox_gate_dependency_not_ready",
    "sandbox_profile_gate_not_ready",
    "sandbox_capability_gate_not_ready"
  ],
  "forbiddenOwnership": [
    "http-listener",
    "rpc-listener",
    "api-route",
    "generated-sdk",
    "provider-mechanism",
    "database-pool-construction",
    "database-migration",
    "scheduler-policy",
    "quota-metering-policy",
    "secret-injection-mechanism",
    "deployment-profile-materialization"
  ],
  "authorization": {
    "publicExports": false,
    "runtimeEntrypoints": false,
    "configKeys": false,
    "httpOrRpc": false,
    "providerImplementation": false,
    "secretKmsImplementation": false,
