  "typedConfig": {
    "type": "SandboxServiceHostConfig",
    "sourceAuthority": "runtime-bootstrap-normalized-safe-config",
    "fields": [
      {
        "name": "sandbox_profile_id",
        "type": "SandboxProfileId",
        "required": true,
        "mustEqual": "{sandbox_deployment_profile}.{sandbox_environment}"
      },
      {
        "name": "sandbox_deployment_profile",
        "type": "SandboxDeploymentProfile",
        "required": true,
        "allowedValues": ["standalone", "cloud"]
      },
      {
        "name": "sandbox_environment",
        "type": "SandboxEnvironment",
        "required": true
      },
      {
        "name": "sandbox_runtime_target",
        "type": "SandboxRuntimeTarget",
        "required": true,
        "allowedValues": ["server"]
      },
      {
        "name": "sandbox_readiness_timeout_ms",
        "type": "u64",
        "required": true,
        "minimum": 1,
        "maximum": 60000
      },
      {
        "name": "sandbox_shutdown_timeout_ms",
        "type": "u64",
        "required": true,
        "minimum": 1,
        "maximum": 300000
      },
      {
        "name": "sandbox_required_capabilities",
        "type": "Set<SandboxCapability>",
        "required": true,
        "maximumItems": 64
      },
      {
        "name": "sandbox_required_isolation_assurance",
        "type": "SandboxIsolationAssurance",
        "required": true
      }
    ],
    "forbiddenSources": [
      "process-environment",
      "dotenv",
      "source-checkout-metadata",
      "global-mutable-state",
      "embedded-secret-material"
    ]
  },
  "injectedDependencies": [
    {
      "name": "sandbox_session_repository",
      "port": "SandboxSessionRepository",
      "owner": "sdkwork-intelligence-sandbox-service",
      "serverAuthority": "sdkwork-intelligence-sandbox-repository-sqlx",
      "bootstrapBoundaryContract": "./sandbox-service-host-bootstrap.contract.json",
      "required": true,
      "forbiddenServerFallbacks": ["memory", "sqlite"]
    },
    {
      "name": "sandbox_provider_registry",
      "port": "SandboxProviderRegistry",
