        "sandbox_deployment_profile",
        "sandbox_selected_provider_kind"
      ],
      "sandbox_deployment_profile_authority": "SandboxServiceHostConfig",
      "sandbox_selected_provider_authority": "SandboxProviderRegistry-after-service-policy-selection",
      "sandbox_exact_mappings": [
        {
          "sandbox_deployment_profile": "standalone",
