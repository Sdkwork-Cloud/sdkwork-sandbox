  },
  "verificationScenarios": [
    "sandbox_profile_contract_parity",
    "sandbox_bootstrap_config_secret_runtime_directory_and_telemetry_boundary",
    "sandbox_missing_dependency_fails_closed",
    "sandbox_provider_identity_mismatch_fails_closed",
    "sandbox_provider_assurance_mismatch_fails_closed",
    "sandbox_readiness_is_bounded_and_repeatable",
    "sandbox_readiness_output_is_redacted",
    "sandbox_shutdown_is_bounded_and_idempotent",
    "sandbox_server_store_has_no_memory_or_sqlite_fallback",
    "sandbox_gate_dependency_resolution_fails_closed",
    "sandbox_standalone_local_requires_local_host_boundary",
    "sandbox_standalone_local_requires_data_residency_and_recovery",
    "sandbox_standalone_firecracker_requires_cold_microvm_dependencies",
    "sandbox_cloud_firecracker_requires_trust_admission_and_capacity",
