  "capabilityReadinessGates": {
    "sandbox_command": {
      "sandbox_required_dependency_ids": [
        "sandbox_provider_delivery_gates",
        "sandbox_command_contract"
      ],
      "sandbox_required_bindings": ["SandboxCommandExecutor"],
      "sandbox_required_evidence": [
        "sandbox_provider_descriptor_supports_command",
        "sandbox_common_command_conformance_passed",
        "sandbox_executor_platform_cleanup_conformance_passed"
      ],
      "sandbox_selected_profile_gate_required": true,
      "sandbox_provider_descriptor_alone_is_ready": false
    },
    "sandbox_terminal": {
      "sandbox_depends_on_capability_gates": ["sandbox_command"],
      "sandbox_required_evidence": [
        "sandbox_provider_descriptor_supports_terminal",
        "sandbox_authenticated_terminal_readiness_passed",
        "sandbox_descendant_supervision_and_cleanup_conformance_passed"
      ],
      "sandbox_local_windows_and_linux_real_runner_evidence_required": true,
      "sandbox_local_macos_terminal_allowed": false,
      "sandbox_unsupported_terminal_request_action": "fail-closed",
      "sandbox_provider_descriptor_alone_is_ready": false
    }
