      "decisionType": "SandboxAdmissionDecision",
      "grantType": "SandboxAdmissionGrant",
      "errorType": "SandboxAdmissionError",
      "providerNeutral": true
    },
    "sandbox_node_inventory_port": {
      "type": "SandboxNodeInventoryPort",
