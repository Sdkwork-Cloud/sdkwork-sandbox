    "sandbox_attachment_may_own_object_storage_lifecycle": false,
    "sandbox_direct_storage_provider_sdk_allowed": false
  },
  "deviceBoundary": {
    "sandbox_guest_block_device_required": true,
    "sandbox_direct_host_directory_mount_allowed": false,
    "sandbox_rootfs_workspace_cache_temp_devices_separate": true,
    "sandbox_rootfs_read_only_required": true,
    "sandbox_workspace_device_count_max": 1,
    "sandbox_device_identity_private": true,
    "sandbox_device_shared_across_active_tenant_bindings": false,
    "sandbox_filesystem_type_allowlist_required": true,
    "sandbox_mount_options_allowlist_required": true,
    "sandbox_read_only_mode_enforced_when_granted": true,
