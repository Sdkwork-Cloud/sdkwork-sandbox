    "workspaceMountModes": ["ReadOnly", "ReadWrite"],
    "ambientTenantOrWorkspaceContextAllowed": false
  },
  "grant": {
    "requiredFields": [
      "sandbox_workspace_attachment_grant_id",
      "sandbox_grant_issuer",
      "sandbox_grant_audience",
      "sandbox_tenant_scope_hash",
      "sandbox_workspace_id",
      "sandbox_workspace_revision_ref",
      "sandbox_session_id",
      "sandbox_runtime_binding_id",
      "sandbox_provider_id",
      "sandbox_fencing_token",
      "sandbox_allowed_operations",
      "sandbox_workspace_mount_mode",
      "sandbox_capacity_limit_bytes",
      "sandbox_issued_at",
      "sandbox_expires_at",
      "sandbox_nonce",
      "sandbox_signature"
    ],
    "audience": "sdkwork-sandbox-workspace-block-device",
    "shortLived": true,
    "singleTenant": true,
    "singleWorkspaceRevision": true,
    "singleSessionAndBinding": true,
    "singleProvider": true,
    "requestFingerprintBound": true,
    "replayProtectionRequired": true,
    "revocationCheckRequired": true,
    "failClosedOnClockUncertainty": true
  },
  "ownership": {
    "sandbox_agents_owns_workspace_identity_lifecycle_authorization_and_retention": true,
    "sandbox_kernel_only_maps_authorized_opaque_identity": true,
    "sandbox_service_owns_session_binding_fencing_and_attachment_orchestration": true,
    "sandbox_attachment_adapter_only_owns_runtime_projection": true,
    "sandbox_host_isolation_broker_only_executes_authorized_privileged_steps": true,
    "sandbox_provider_only_consumes_verified_attachment_result": true,
