    "safeFields": [
      "sandbox_workspace_attachment_operation_id",
      "sandbox_workspace_id",
      "sandbox_workspace_revision_ref",
      "sandbox_session_id",
      "sandbox_runtime_binding_id",
      "sandbox_workspace_attachment_state",
      "sandbox_workspace_mount_mode",
      "sandbox_capacity_limit_bytes",
      "sandbox_observed_fencing_token",
      "sandbox_reason_code",
      "sandbox_retryable",
      "sandbox_trace_id"
    ],
    "providerPrivateAttachmentReferenceProtected": true,
    "physicalMetadataAllowed": false
  },
  "errorCodes": [
    { "code": "sandbox_workspace_attachment_invalid_request", "retryable": false },
    { "code": "sandbox_workspace_attachment_grant_denied", "retryable": false },
    { "code": "sandbox_workspace_revision_conflict", "retryable": false },
    { "code": "sandbox_workspace_attachment_stale_fencing", "retryable": true },
    { "code": "sandbox_workspace_attachment_operation_conflict", "retryable": false },
    { "code": "sandbox_workspace_attachment_protection_unavailable", "retryable": true },
    { "code": "sandbox_workspace_attachment_integrity_failed", "retryable": false },
    { "code": "sandbox_workspace_attachment_capacity_exceeded", "retryable": false },
    { "code": "sandbox_workspace_attachment_deadline_exceeded", "retryable": true },
    { "code": "sandbox_workspace_attachment_sanitization_incomplete", "retryable": true },
    { "code": "sandbox_workspace_attachment_quarantined", "retryable": false },
    { "code": "sandbox_workspace_attachment_internal_failure", "retryable": false }
  ],
  "bounds": {
    "sandbox_request_max_bytes": 65536,
    "sandbox_result_max_bytes": 65536,
    "sandbox_grant_ttl_seconds_max": 60,
    "sandbox_deadline_ms_max": 600000,
    "sandbox_cleanup_step_count_max": 64,
    "sandbox_reconciliation_batch_size_max": 100,
    "sandbox_reference_max_length": 512,
    "sandbox_reason_code_max_length": 128,
    "sandbox_capacity_limit_must_be_positive": true,
    "sandbox_capacity_limit_must_not_exceed_policy": true
