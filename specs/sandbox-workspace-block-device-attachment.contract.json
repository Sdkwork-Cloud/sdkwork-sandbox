    "sandbox_key_unwrap_only_in_trusted_node_boundary": true,
    "sandbox_in_memory_key_zeroization_required": true,
    "sandbox_integrity_check_before_guest_mount": true,
    "sandbox_key_revocation_and_rotation_authority_required": true,
    "sandbox_secret_kms_implementation_authorized": false
  },
  "lifecycle": {
    "states": ["Prepared", "Attached", "Detaching", "Sanitizing", "Detached", "Quarantined"],
    "initialState": "Prepared",
    "terminalReusableState": "Detached",
    "failureState": "Quarantined",
    "sandbox_persistent_workspace_content_preserved_on_detach": true,
    "sandbox_ephemeral_overlay_cache_temp_destroyed_on_cleanup": true,
    "sandbox_workspace_revision_immutable_during_one_attachment": true,
    "sandbox_detach_required_before_binding_reuse": true,
    "sandbox_quarantined_attachment_reusable": false
  },
  "fencingAndIdempotency": {
    "sandbox_highest_fencing_token_persisted_per_attachment": true,
    "sandbox_stale_token_rejected_before_side_effect": true,
    "sandbox_same_operation_same_fingerprint_replays_result": true,
    "sandbox_same_operation_different_fingerprint_conflicts": true,
    "sandbox_state_transition_atomic_with_side_effect_record": true,
    "sandbox_restart_recovery_required": true
  },
  "readiness": {
    "type": "SandboxWorkspaceBlockDeviceReadiness",
    "failureMode": "fail-closed",
    "requiredDimensions": [
      "sandbox_authorization_and_revision",
      "sandbox_tenant_session_binding",
      "sandbox_fencing",
      "sandbox_data_encryption",
      "sandbox_data_integrity",
      "sandbox_capacity_limit",
      "sandbox_mount_mode",
      "sandbox_guest_mount_acknowledgement",
      "sandbox_prior_projection_residue_clear"
    ],
    "degradedMayReportWorkspaceAttached": false,
    "readinessClaimIsMicroVmEvidenceByItself": false
  },
  "sanitization": {
    "orderedSteps": [
      "sandbox_revoke_guest_access",
      "sandbox_flush_guest_and_host_writes",
      "sandbox_unmount_guest_filesystem",
      "sandbox_detach_guest_block_device",
      "sandbox_close_encryption_mapping",
      "sandbox_destroy_ephemeral_key_handle",
      "sandbox_destroy_ephemeral_overlay_cache_temp",
      "sandbox_scan_provider_projection_residue",
      "sandbox_record_sanitization_outcome"
    ],
    "sandbox_persistent_workspace_content_wiped": false,
    "sandbox_ephemeral_cryptographic_erase_required": true,
    "sandbox_physical_discard_or_secure_erase_claim_requires_capability_evidence": true,
    "sandbox_cross_tenant_residue_scan_before_reuse": true,
    "sandbox_failed_or_unknown_sanitization_quarantines_attachment": true,
    "sandbox_quarantine_blocks_node_or_device_reuse": true,
    "sandbox_cleanup_bounded_and_reconcilable": true
  },
