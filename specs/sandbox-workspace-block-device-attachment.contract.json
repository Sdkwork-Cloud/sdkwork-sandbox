{
  "schemaVersion": 1,
  "kind": "sdkwork.sandbox.workspace-block-device-attachment-contract",
  "status": "draft",
  "requirementId": "REQ-2026-0013",
  "implementationAuthorized": false,
  "compositionPort": {
    "type": "SandboxWorkspaceAttachmentPort",
    "providerNeutral": true,
    "serviceHostInjectsOnlyThisPort": true,
    "providerBranchingAllowed": false
  },
  "mechanismPortCandidate": {
    "type": "SandboxWorkspaceBlockDevicePort",
    "requestType": "SandboxWorkspaceBlockDeviceRequest",
    "resultType": "SandboxWorkspaceBlockDeviceResult",
    "errorType": "SandboxWorkspaceBlockDeviceError",
    "grantType": "SandboxWorkspaceAttachmentGrant"
  },
  "operations": [
    {
      "name": "sandbox_prepare_workspace_attachment",
      "sideEffect": true
    },
    {
      "name": "sandbox_attach_workspace_device",
      "sideEffect": true
    },
    {
      "name": "sandbox_inspect_workspace_attachment",
      "sideEffect": false
    },
    {
      "name": "sandbox_detach_workspace_device",
      "sideEffect": true
    },
    {
      "name": "sandbox_sanitize_workspace_projection",
      "sideEffect": true
    }
  ],
  "request": {
    "requiredFields": [
      "sandbox_workspace_attachment_operation_id",
      "sandbox_tenant_scope_hash",
      "sandbox_workspace_id",
      "sandbox_workspace_revision_ref",
      "sandbox_session_id",
      "sandbox_runtime_binding_id",
      "sandbox_provider_id",
      "sandbox_fencing_token",
      "sandbox_workspace_attachment_ref",
      "sandbox_workspace_attachment_grant",
      "sandbox_workspace_mount_mode",
      "sandbox_capacity_limit_bytes",
      "sandbox_request_fingerprint",
      "sandbox_deadline_ms"
    ],
    "unknownFieldsRejected": true,
