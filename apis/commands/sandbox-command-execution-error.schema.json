{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.dev/sandbox/commands/sandbox-command-execution-error.schema.v1.json",
  "title": "SandboxCommandExecutionError",
  "description": "Candidate safe Sandbox command error taxonomy. REQ-2026-0007 remains draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "traceId",
    "sandboxCommandOperationId",
    "sandboxErrorCode",
    "sandboxRetryable",
    "sandboxSafeMessage"
  ],
  "properties": {
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sandboxCommandOperationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sandboxErrorCode": {
      "type": "string",
      "enum": [
        "invalid-request",
        "unsupported-capability",
        "policy-denied",
        "stale-fencing",
        "idempotency-conflict",
        "operation-in-progress",
        "command-not-found",
        "provider-unavailable",
        "result-unavailable",
        "internal-failure"
      ]
    },
    "sandboxRetryable": { "type": "boolean" },
    "sandboxSafeMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]*$"
    },
    "sandboxRetryAfterMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sandboxErrorCode": {
            "enum": ["stale-fencing", "operation-in-progress", "provider-unavailable", "result-unavailable"]
          }
        },
        "required": ["sandboxErrorCode"]
      },
      "then": {
        "properties": { "sandboxRetryable": { "const": true } }
      },
      "else": {
        "properties": { "sandboxRetryable": { "const": false } }
      }
    },
    {
      "if": {
        "properties": {
          "sandboxErrorCode": {
            "enum": ["operation-in-progress", "provider-unavailable", "result-unavailable"]
          }
        },
        "required": ["sandboxErrorCode"]
      },
      "else": {
        "not": { "required": ["sandboxRetryAfterMs"] }
      }
    }
  ],
  "x-sdkwork-status": "draft",
  "x-sdkwork-requirement-id": "REQ-2026-0007",
  "x-sdkwork-detail-policy": "safe-message-only",
  "x-sdkwork-pre-start-or-result-unavailable-only": true,
  "x-sdkwork-retry-policy": "code-bound-prerequisites",
  "x-sdkwork-retry-prerequisites": {
    "stale-fencing": "new-fencing-authority",
    "operation-in-progress": "same-operation-and-fingerprint",
    "provider-unavailable": "same-operation-and-fingerprint",
    "result-unavailable": "same-operation-and-fingerprint"
  }
}
