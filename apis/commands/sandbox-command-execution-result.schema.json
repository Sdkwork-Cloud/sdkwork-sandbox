{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.dev/sandbox/commands/sandbox-command-execution-result.schema.v1.json",
  "title": "SandboxCommandExecutionResult",
  "description": "Candidate bounded and binary-safe Sandbox command result. REQ-2026-0007 remains draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "traceId",
    "sandboxProviderId",
    "sandboxCommandOperationId",
    "sandboxRequestFingerprint",
    "sandboxCommandResultReplayed",
    "sandboxOutcome",
    "sandboxExitStatus",
    "sandboxStdoutBase64",
    "sandboxStderrBase64",
    "sandboxStdoutTruncated",
    "sandboxStderrTruncated",
    "sandboxStartedAt",
    "sandboxFinishedAt",
    "sandboxCleanupStatus",
    "sandboxCleanupDurationMs",
    "sandboxResourceUsage"
  ],
  "properties": {
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sandboxProviderId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sandboxCommandOperationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sandboxRequestFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sandboxCommandResultReplayed": {
      "type": "boolean"
    },
    "sandboxOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "timed-out",
        "cancelled",
        "output-limit",
        "resource-exhausted",
        "fencing-lost"
      ]
    },
    "sandboxExitStatus": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sandboxExitKind", "sandboxExitCode"],
          "properties": {
            "sandboxExitKind": {
              "type": "string",
              "const": "exited"
            },
            "sandboxExitCode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sandboxExitKind", "sandboxSignalName"],
          "properties": {
            "sandboxExitKind": {
              "const": "signaled"
            },
            "sandboxSignalName": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
            }
          }
        }
      ]
    },
    "sandboxStdoutBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "contentMediaType": "application/octet-stream",
      "maxLength": 89478488
    },
    "sandboxStderrBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "contentMediaType": "application/octet-stream",
      "maxLength": 89478488
    },
    "sandboxStdoutTruncated": { "type": "boolean" },
    "sandboxStderrTruncated": { "type": "boolean" },
    "sandboxStartedAt": { "type": "string", "format": "date-time" },
    "sandboxFinishedAt": { "type": "string", "format": "date-time" },
    "sandboxCleanupStatus": {
      "type": "string",
      "enum": ["not-required", "completed", "failed"]
    },
    "sandboxCleanupDurationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "sandboxResourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandboxDurationMs",
        "sandboxStdoutCapturedBytes",
        "sandboxStderrCapturedBytes",
        "sandboxProcessCount"
      ],
      "properties": {
        "sandboxDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "sandboxStdoutCapturedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "sandboxStderrCapturedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "sandboxProcessCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sandboxOutcome": { "const": "succeeded" } },
        "required": ["sandboxOutcome"]
      },
      "then": {
        "properties": {
          "sandboxExitStatus": {
            "type": "object",
            "required": ["sandboxExitKind", "sandboxExitCode"],
            "properties": {
              "sandboxExitKind": { "const": "exited" },
              "sandboxExitCode": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "sandboxOutcome": { "const": "failed" } },
        "required": ["sandboxOutcome"]
      },
      "then": {
        "properties": {
          "sandboxExitStatus": {
            "oneOf": [
              {
                "type": "object",
                "required": ["sandboxExitKind", "sandboxExitCode"],
                "properties": {
                  "sandboxExitKind": { "const": "exited" },
                  "sandboxExitCode": { "type": "integer", "minimum": 1, "maximum": 255 }
                }
              },
              {
                "type": "object",
                "required": ["sandboxExitKind", "sandboxSignalName"],
                "properties": { "sandboxExitKind": { "const": "signaled" } }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "sandboxOutcome": { "const": "output-limit" } },
        "required": ["sandboxOutcome"]
      },
      "then": {
        "anyOf": [
          {
            "properties": { "sandboxStdoutTruncated": { "const": true } },
            "required": ["sandboxStdoutTruncated"]
          },
          {
            "properties": { "sandboxStderrTruncated": { "const": true } },
            "required": ["sandboxStderrTruncated"]
          }
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": { "sandboxStdoutTruncated": { "const": true } },
            "required": ["sandboxStdoutTruncated"]
          },
          {
            "properties": { "sandboxStderrTruncated": { "const": true } },
            "required": ["sandboxStderrTruncated"]
          }
        ]
      },
      "then": {
        "properties": { "sandboxOutcome": { "const": "output-limit" } }
      }
    },
    {
      "if": {
        "properties": {
          "sandboxOutcome": {
            "enum": ["timed-out", "cancelled", "output-limit", "resource-exhausted", "fencing-lost"]
          }
        },
        "required": ["sandboxOutcome"]
      },
      "then": {
        "properties": {
          "sandboxCleanupStatus": { "enum": ["completed", "failed"] }
        }
      }
    }
  ],
  "x-sdkwork-status": "draft",
  "x-sdkwork-requirement-id": "REQ-2026-0007",
  "x-sdkwork-output-encoding": "base64-binary",
  "x-sdkwork-terminal-outcome-authority": true,
  "x-sdkwork-terminal-arbitration": "executor-durable-first-terminal-cas",
  "x-sdkwork-cleanup-failure-policy": "explicit-result-and-binding-quarantine"
}
